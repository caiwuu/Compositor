    },
    "Hue and saturation of this wheel." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此色轮的色相和饱和度。"
          }
        }
      }
    },
    "Hue around the wheel, saturation outward from the center. Control-click to show the histogram." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "色相沿色轮分布，饱和度从中心向外增加。按住 Control 点按可显示直方图。"
          }
        }
      }
    },
    "Hue range where green defringe runs." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "绿色去边作用的色相范围。"
          }
        }
      }
    },
    "Hue range where purple defringe runs." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "紫色去边作用的色相范围。"
          }
        }
      }
    },
    "Hue shifts the color, Saturation its strength, and Luminance its brightness." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“色相”改变颜色，“饱和度”改变其强度，“明亮度”改变其亮度。"
